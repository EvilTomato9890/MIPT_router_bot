# Создайте токен через @BotFather. Никогда не коммитьте .env.
BOT_TOKEN=
BOOTSTRAP_ADMIN_ID=
DB_PATH=./data/router-bot.sqlite
# Без Google по умолчанию. memory — только демонстрация, google — реальное подключение.
SHEETS_MODE=disabled
SPREADSHEET_ID=1N6lyJS7-PZ_hunmjnY06-0tnEEeOaP0Ypn-yEVfooK4
SHEET_TITLE=7ка
SHEET_ID=966826055
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
# true разрешается только после согласования O:AO и теста на копии, см. docs/GOOGLE_SHEETS.md.
SHEETS_MAPPING_APPROVED=false
# Раздельное хранение контактов: 365 дней ПОСЛЕ закрытия выдачи; 0 — отключить автоочистку.
CONTACT_RETENTION_DAYS=365
REMINDER_TIME=10:00
REMINDER_OFFSETS=14,7,1,0
TIMEZONE=Europe/Moscow
BACKUP_DIR=./backups
BACKUP_KEEP=14
SYNC_ALERT_HOURS=6
